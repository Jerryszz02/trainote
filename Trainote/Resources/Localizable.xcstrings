    },
    "settings.restoreInstructions": {
      "comment": "settings restoreInstructions",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose “Export all data” in Settings and save the JSON file somewhere safe. On your new device, choose “Restore local backup”, preview the record count and confirm. Records with existing IDs are skipped; current data is not deleted."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在设置中选择“导出全部数据”，将 JSON 文件保存到安全位置。更换设备后选择“恢复本地备份”，先预览记录数量，再确认恢复。已有相同 ID 的记录会跳过，当前数据不会被删除。"
          }
        }
      }
    },
    "settings.restorePreview": {
      "comment": "settings restorePreview",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check and add %lld records? Existing IDs will be skipped and current data will be kept."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将检查并添加 %lld 条记录；已有相同 ID 的记录会跳过，不会删除当前数据。确定恢复吗？"
          }
        }
      }
    },
    "settings.restoreResult": {
      "comment": "settings restoreResult",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Restore complete: %lld added, %lld skipped."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "恢复完成：新增 %lld 条，跳过 %lld 条。"
          }
        }
      }
    },
