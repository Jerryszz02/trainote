    "core.averages.use.only.the.days.with.recorded.nutrition.values.goals.reflect.each.day.s.hi": {
      "comment": "Application-owned core screen text",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Averages use only the %lld day with recorded nutrition values. Goals reflect each day's history. Missing days are not treated as zero intake, and recorded values may not reflect total daily intake."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Averages use only the %lld days with recorded nutrition values. Goals reflect each day's history. Missing days are not treated as zero intake, and recorded values may not reflect total daily intake."
                }
              }
            }
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "平均值仅按填写过营养的 %lld 天计算。目标按各日历史显示；漏记日期不按零摄入处理，已记录数值不代表全天实际摄入。"
          }
        }
      }
    },
