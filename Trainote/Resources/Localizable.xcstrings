        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Read this version's processing notice before enabling AI. Turning it off stops future sends and retries. Cancelling requests does not automatically delete data already sent to third parties."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
