    "settings.backupHelp": {
      "comment": "settings backupHelp",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Exports v2 and restores v1 / v2; older app versions may not read v2. Includes manual health records, goal history, training and nutrition. Excludes imported health caches, permissions, device credentials and derived reports. Backups are saved only to the location you choose. Keep them safe."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "导出 v2，支持恢复 v1 / v2；旧版 App 不保证能读 v2。包含手动健康资料、目标历史、训练和饮食；不包含健康导入缓存、授权、设备凭据或派生报告。备份只保存在你选择的位置，请妥善保管。"
          }
        }
      }
    },
