    "health.trendview.you.adopt.the.initial.targets.first.b01f1e": {
      "comment": "TrendView display text",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You adopt the initial targets first. Later adjustments require sufficient records and boundary checks, happen at most every 7 days and are capped at 100 kcal or 5% of the current target. You can pause or undo at any time."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "初始目标由你先采用。之后仅在记录充分且通过边界检查时，每 7 天最多调整一次，每次不超过 100 kcal 或当前目标的 5%。可随时暂停或撤销。"
          }
        }
      }
    },
