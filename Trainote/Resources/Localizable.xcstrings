          "stringUnit": {
            "state": "translated",
            "value": "AI consent is independent of the health connection. When enabled, necessary workout, food, weight, and health trend summaries are sent through a proxy to DeepSeek. AI cannot change targets or workout history."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "AI 同意与健康连接独立。启用后，必要的训练、饮食、体重和健康趋势汇总会通过代理交由 DeepSeek 处理。AI 不能修改目标或训练历史。"
          }
        }
      }
    },
    "interaction.help.completeHelp": {
      "comment": "interaction.help.completeHelp",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Missing nutrition is different from actual zero intake. Editing a record invalidates the confirmation that the selected day’s food log is complete. Trends include only complete days through yesterday."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有填写营养与真实零摄入不同。确认所选日期饮食完整后，编辑记录会使确认失效；趋势统计只计截至昨天的完整日。"
          }
        }
      }
    },
    "interaction.help.contents": {
      "comment": "interaction.help.contents",
      "extractionState": "manual",
      "localizations": {
