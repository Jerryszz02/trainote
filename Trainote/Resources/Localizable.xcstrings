    "health.healthhelpview.a.representative.daily.weight.is.selected.13ddad": {
      "comment": "HealthHelpView display text",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A representative daily weight is selected in the analysis time zone without mixing sources: your chosen reading first, then morning readings or the median from your preferred source. Raw records are preserved. Missing dates are not filled with zero; outliers are flagged for review. Smoothing uses a 7-day time constant, and rate estimates use the last 21 complete days."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "体重先按分析时区选择每天的代表值，不混合不同来源：优先你指定的读数，其次首选来源的晨间值或中位数。原始记录保留；没有记录的日期不补零，异常值会提示复核。趋势平滑采用 7 天时间常数，速度估计取最近 21 个完整日。"
          }
        }
      }
    },
    "health.healthhelpview.ai.and.deepseek.a6db6a": {
      "comment": "HealthHelpView display text",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "AI and DeepSeek"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "AI 与 DeepSeek"
          }
        }
      }
    },
    "health.healthhelpview.ai.consent.is.separate.from.the.3665a4": {
      "comment": "HealthHelpView display text",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "AI consent is separate from the health connection. AI reports are not yet available, and no data is sent to DeepSeek. You can use locally generated basic reports. When AI becomes available, you will receive its data-processing notice and can choose whether to enable it."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "AI 同意与健康连接独立。当前 AI 报告尚未开放，不向 DeepSeek 发送数据；可使用本机生成的基础报告。开放后会提供对应的数据处理说明，由你单独选择是否启用。"
          }
        }
      }
    },
    "health.healthhelpview.backups.v1.v2.582936": {
      "comment": "HealthHelpView display text",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Backups v1 / v2"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "备份 v1 / v2"
          }
        }
      }
    },
    "health.healthhelpview.basic.reports.organize.current.trends.recovery.38a6a9": {
      "comment": "HealthHelpView display text",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Basic reports organize current trends, recovery facts and rule-based suggestions locally. Review evidence to check values and missing records. Historical AI reports are read-only; return to current suggestions to confirm starting a workout."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "基础报告在本机整理当前趋势、恢复事实和规则建议。查看依据可以核对数值与缺失记录；历史 AI 报告只读，训练采用需要回到当前建议重新确认。"
          }
        }
      }
    },
    "health.healthhelpview.calibration.reads.the.last.90.days.44bf37": {
      "comment": "HealthHelpView display text",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Calibration reads the last 90 days and requires at least 6 fitting pairs followed by 4 independent validation pairs. Comparisons require the same exercise, recording mode, set order, weight and recorded RIR, plus pre-workout check-ins. Data gaps exclude unsuitable comparisons."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "校准读取最近 90 天，至少需要 6 对拟合记录和随后独立的 4 对验证记录。仅比较相同动作、记录方式、组顺序、重量和已填写 RIR 的表现；还需训练前体感回答，数据缺口会排除不合格的比较。"
          }
        }
      }
    },
    "health.healthhelpview.candidate.parameters.must.outperform.both.baseline.b85e6a": {
      "comment": "HealthHelpView display text",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Candidate parameters must outperform both baseline and current parameters on later held-out records, improving by at least 5% and more than 1 squared-error point. Evaluation happens at most every 7 days, with changes capped at 10% and time constants limited to 24–72 hours. This does not prove individual prediction validity; equipment identity, tempo and technique changes are not currently measured."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "候选参数必须在留出的后续记录上同时优于基础参数和当前参数，至少改善 5% 且超过 1 个平方误差点；最多每 7 天评估一次，每次调整不超过 10%，时间常数限制在 24–72 小时。它不能证明个人预测有效，器械实体、节奏与技术变化目前未被测量。"
          }
        }
      }
    },
    "health.healthhelpview.contact.the.maintainer.on.github.d4bfc8": {
      "comment": "HealthHelpView display text",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Contact the maintainer on GitHub"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 GitHub 联系维护者"
          }
        }
      }
    },
    "health.healthhelpview.daily.intake.is.compared.with.the.1579a6": {
      "comment": "HealthHelpView display text",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Daily intake is compared with the target in effect that day. Unknown historical targets or differences above 15% require an adherence review before any target adjustment. Initial targets and a new baseline after profile changes require explicit adoption. Later adjustments happen at most once every 7 days, capped at 100 kcal or 5% of the current target. The lower bound uses both the current resting energy estimate and the initial estimate for this cycle; watch activity calories are not added back."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "饮食摄入按每一天当时的目标比较；历史目标未知或偏差超过 15% 时先复核执行，不据此自动改目标。初始目标和资料更新后的新基线都需要明确采用。之后每 7 天最多调整一次，每次不超过 100 kcal 或当前目标的 5%，下限由当前静息能量估计与本周期初始估计共同约束；手表活动热量不再加回。"
          }
        }
      }
    },
    "health.healthhelpview.data.and.apple.health.20baa0": {
      "comment": "HealthHelpView display text",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Data and Apple Health"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "数据与 Apple 健康"
          }
        }
      }
    },
    "health.healthhelpview.disconnecting.health.stops.sync.clears.imported.00d82a": {
      "comment": "HealthHelpView display text",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Disconnecting health stops sync, clears imported cache and anchors, and deletes dependent analysis reports while preserving manual records. It does not delete original data in Apple Health. Failures prompt you to retry."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "断开健康连接会停止同步、清除导入缓存和锚点，并删除依赖它们的分析报告，保留手动记录；不会删除 Apple 健康中的原始数据。失败会提示重试。"
          }
        }
      }
    },
    "health.healthhelpview.exports.use.v2.json.both.v1.a5b92c": {
      "comment": "HealthHelpView display text",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Exports use v2 JSON. Both v1 and v2 can be restored; unknown future versions are rejected. Older app versions may not read v2. Exports include manual health details, target history, workouts and food records. They exclude imported health cache, sync anchors, health or AI consent, device credentials and derived reports."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前导出 v2 JSON，可恢复 v1 和 v2，未来未知版本会被拒绝。旧版 App 不保证能读 v2。导出包括手动健康资料、目标历史、训练和饮食记录，不包括健康导入缓存、同步锚点、健康或 AI 同意、设备凭据和派生报告。"
          }
        }
      }
    },
    "health.healthhelpview.general.nutrition.suggestions.are.for.healthy.2d4323": {
      "comment": "HealthHelpView display text",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "General nutrition suggestions are for healthy adults doing everyday fitness. Minors, pregnancy, breastfeeding, medical conditions and other special nutrition needs should use manual targets or a professional plan. Adopting targets requires your choice; an app update does not change old manual targets automatically."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "通用营养建议面向健康成年人的日常健身。未成年人、孕哺期、疾病管理和其他特殊营养需求应保留手动目标或使用专业方案。目标采用需要明确选择；旧手动目标不会因升级而自动改变。"
          }
        }
      }
    },
    "health.healthhelpview.help.and.contact.7cca8d": {
      "comment": "HealthHelpView display text",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Help and contact"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "帮助与联系"
          }
        }
      }
    },
    "health.healthhelpview.how.the.recovery.index.works.1b0803": {
      "comment": "HealthHelpView display text",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "How the recovery index works"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "恢复指数如何计算"
          }
        }
      }
    },
    "health.healthhelpview.local.load.uses.the.last.28.5cb351": {
      "comment": "HealthHelpView display text",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Local load uses the last 28 days with exponential time decay and an initial 36-hour time constant. The recovery index is 100 × exp(−remaining weighted load / 6), rounded to the nearest 5 points. Scores of 80 or above, 50–75 and below 50 are engineering thresholds without physiological accuracy validation. Muscles without usable records remain unknown."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "局部负荷取最近 28 天记录，随时间指数衰减，初始时间常数为 36 小时；恢复指数为 100 × exp(−残余加权负荷 / 6)，显示时取最近的 5 分。显示 80 及以上、50–75、低于 50 分为三档工程阈值，未经生理准确性验证。没有可用记录的肌群保持未知。"
          }
        }
      }
    },
    "health.healthhelpview.manual.records.include.workouts.rir.food.da9aac": {
      "comment": "HealthHelpView display text",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Manual records include workouts, RIR, food, targets, body details, weight and optional check-ins. Read access to weight, sleep, resting heart rate, HRV SDNN, steps, active energy and workouts is requested only after you connect. Write access is not requested."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "手动记录包括训练、RIR、饮食、目标、身体资料、体重和可选体感。只有主动连接后才请求读取体重、睡眠、静息心率、HRV SDNN、步数、活动能量和训练；不请求写入权限。"
          }
        }
      }
    },
    "health.healthhelpview.manual.records.stay.on.this.device.769a6c": {
      "comment": "HealthHelpView display text",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Manual records stay on this device until you delete them. Trainote has no ads, analytics tracking or added telemetry and does not sell health records. Health cache and consent records are stored separately and are not transferred in JSON backups."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "手动记录保存在本机，直到你删除。Trainote 不包含广告、分析追踪或新增遥测，不出售健康记录。健康缓存与同意记录独立存储，不随 JSON 备份转移。"
          }
        }
      }
    },
    "health.healthhelpview.methods.and.data.use.93b2bb": {
      "comment": "HealthHelpView display text",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Methods and data use"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "方法与数据使用"
          }
        }
      }
    },
    "health.healthhelpview.methods.and.scope.16b0da": {
      "comment": "HealthHelpView display text",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Methods and scope"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "分析方法与适用范围"
          }
        }
      }
    },
    "health.healthhelpview.only.completed.mapped.working.sets.are.d45810": {
      "comment": "HealthHelpView display text",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only completed, mapped working sets are used; warm-up sets are excluded. Historical sets with an unknown type are treated as working sets. Missing RIR uses default effort and retains a missing-data flag. Primary muscles have weight 1, secondary muscles 0.5; the maximum weight is used for each muscle. These weights are not EMG proportions."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅使用已完成、可映射的工作组；热身组不计入。历史组类型未知时暂按工作组，未填 RIR 使用默认努力程度，并保留缺失标记。主肌群权重 1、次肌群 0.5，同一肌群取最大权重；这些权重不是肌电比例。"
          }
        }
      }
    },
    "health.healthhelpview.personal.calibration.and.reset.c88df2": {
      "comment": "HealthHelpView display text",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Personal calibration and reset"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "个体校准与重置"
          }
        }
      }
    },
    "health.healthhelpview.report.problems.on.the.project.s.5556e5": {
      "comment": "HealthHelpView display text",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Report problems on the project's issue page. Do not attach real health records, complete backups or credentials to public issues."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "遇到问题可通过项目问题页反馈。请勿在公开问题中附上真实健康记录、完整备份或凭据。"
          }
        }
      }
    },
    "health.healthhelpview.reset.personal.calibration.on.the.recovery.b20b1b": {
      "comment": "HealthHelpView display text",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reset personal calibration on the recovery page. Only a new accumulation start time is saved; workout and check-in history is preserved. Calculations read current data again and do not reuse old fits after records are edited or deleted."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "恢复页可重置个体校准，只保存重新积累的起始时间，保留训练和体感历史。计算时重新读取当前数据，编辑或删除记录后不复用旧的拟合结果。"
          }
        }
      }
    },
    "health.healthhelpview.restore.checks.ids.and.skips.records.302a0e": {
      "comment": "HealthHelpView display text",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Restore checks IDs and skips records already present without deleting current records. A backup cannot restore authorization; you must choose again. Backups are saved where you choose and may contain personal health information. System backups and saved copies are managed by you and your device settings."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "恢复会检查并跳过已有相同 ID 的记录，不删除当前记录。恢复备份不能恢复授权，仍需重新选择。备份保存在你选择的位置，可能含个人健康信息；系统备份或你保存的副本由你及设备设置管理。"
          }
        }
      }
    },
    "health.healthhelpview.sleep.resting.heart.rate.and.hrv.32467a": {
      "comment": "HealthHelpView display text",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sleep, resting heart rate and HRV show systemic status separately and do not directly reduce local muscle scores. Personal baselines require enough records with the same source, device, definition and context. Unknown sources are not mixed. Pain and movement limits take priority over scores; unanswered questions are not treated as symptom-free."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "睡眠、静息心率和 HRV 单独呈现全身状态，不直接扣减局部肌群分数。个人基线需同一来源、设备、定义和情境的足够记录；未知来源不混合。疼痛和活动受限优先于分数，未回答不能当作无症状。"
          }
        }
      }
    },
    "health.healthhelpview.storage.withdrawal.and.deletion.f403ec": {
      "comment": "HealthHelpView display text",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Storage, withdrawal and deletion"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "存储、撤回与删除"
          }
        }
      }
    },
    "health.healthhelpview.sync.runs.on.foreground.refresh.and.735b9a": {
      "comment": "HealthHelpView display text",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sync runs on foreground refresh and system notifications; continuous real-time updates are not guaranteed. Revoking access in Health may not be detected immediately. To clear imported data, use Disconnect and delete imported health data in this app's settings."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "同步随前台刷新和系统通知进行，不保证持续实时。系统内撤回读取权限不一定立即被 App 识别；需要清除已导入内容时，请在本 App 设置中使用“断开并删除健康导入数据”。"
          }
        }
      }
    },
    "health.healthhelpview.the.exercise.catalog.contains.1.324.a9b89d": {
      "comment": "HealthHelpView display text",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The exercise catalog contains 1,324 entries: 38 have engineering text mappings, 1,175 await review and 111 are not applicable. Unreviewed exercises, unsupported recording modes and external strength activities without exercise-level records leave coverage gaps. Duration is not converted to working sets."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前动作表共 1,324 项，其中 38 项完成工程文本映射、1,175 项待核查、111 项不适用。未核查动作、未支持的记录方式或没有逐动作记录的外部力量活动都会留下覆盖缺口；时长不会换算成工作组。"
          }
        }
      }
    },
    "health.healthhelpview.the.provider.api.s.retention.reuse.b014f7": {
      "comment": "HealthHelpView display text",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The provider API's retention, reuse, opt-out and deletion arrangements have not been verified. No promise of third-party zero retention or exclusion from training is made here. A proxy that does not save content does not mean the provider does not retain it."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "尚未核实供应商 API 的保留、再利用、退出和删除安排，因此这里不承诺第三方零保留或不用于训练。代理不保存正文不等于供应商不保留。"
          }
        }
      }
    },
    "health.healthhelpview.the.recovery.index.estimates.training.readiness.54ffcb": {
      "comment": "HealthHelpView display text",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The recovery index estimates training readiness. It is not a percentage of muscle recovery, injury probability or medical diagnosis. Missing records remain unknown; pain and movement limits are handled separately and cannot be offset by a high score."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "恢复指数表示模型估计的训练准备度，不是肌肉恢复百分比、损伤概率或医疗诊断。缺少记录显示未知；疼痛和活动受限独立处理，不能被高分抵消。"
          }
        }
      }
    },
    "health.healthhelpview.these.ranges.weights.and.thresholds.are.d8a6e6": {
      "comment": "HealthHelpView display text",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "These ranges, weights and thresholds are engineering defaults. Average intake is a reference from recorded food, not measured total energy expenditure. Adoption and undo both preserve history. Undo pauses reviews for 7 days, then resumes your chosen mode."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这些范围、权重与阈值是工程初值。摄入均值仅是已记录的摄入参考，不是实测总消耗。目标采用和撤销都会保留历史；撤销后暂停复核 7 天，再按你原先选择的模式执行。"
          }
        }
      }
    },
    "health.healthhelpview.to.manage.read.access.open.health.14b60c": {
      "comment": "HealthHelpView display text",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To manage read access, open Health on your iPhone, tap Summary → your photo or initials at the top right → Apps → Trainote, then change each permission under Allow Trainote to Read. Follow this path in Health."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "管理读取权限：打开 iPhone 上的“健康”App，依次轻点“摘要”→右上角头像或姓名首字母→“App”→“Trainote”，调整各项“从‘健康’读取数据”的许可。请按此路径操作。"
          }
        }
      }
    },
    "health.healthhelpview.trend.and.recovery.analysis.uses.workout.c38346": {
      "comment": "HealthHelpView display text",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Trend and recovery analysis uses workout, food, weight, optional health trends and check-ins. Windows, weights and thresholds for trend smoothing, working-set load, RIR and time decay are versioned engineering defaults. They have not been shown to accurately measure individual physiological recovery."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "趋势与恢复分析使用训练记录、饮食、体重、可选健康趋势及体感。趋势平滑、工作组负荷、RIR 与时间衰减等规则中的窗口、权重和阈值是有版本的工程初值，尚未证明能准确测量个人生理恢复。"
          }
        }
      }
    },
    "health.healthhelpview.trends.and.weekly.nutrition.suggestions.24f35a": {
      "comment": "HealthHelpView display text",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Trends and weekly nutrition suggestions"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "趋势与每周营养建议"
          }
        }
      }
    },
    "health.healthhelpview.turning.off.ai.cancels.future.requests.5907d2": {
      "comment": "HealthHelpView display text",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turning off AI cancels future requests and retries and withdraws server authorization. Retry when offline or after a failure. Health connection and local calculation remain available; historical AI reports can be deleted separately. Cancelling an already sent request cannot guarantee provider deletion."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关闭 AI 会取消后续请求与重试，并撤回服务器授权；离线或失败时需要重试。健康连接与本地计算保留。历史 AI 报告可单独删除。已经发出的请求不能保证通过取消就让供应商删除数据。"
          }
        }
      }
    },
    "health.healthhelpview.weekly.adjustments.require.weight.records.spanning.caa175": {
      "comment": "HealthHelpView display text",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Weekly adjustments require weight records spanning at least 14 days, readings on 8 dates, and at least 3 dates in each of the two weeks. At least 12 of the last 14 days must be explicitly confirmed as complete food records. Today is still in progress and excluded from completed-week reviews. Editing food records invalidates their previous completeness confirmation."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每周调整至少需要跨越 14 天的体重记录、8 个有读数的日期和前后两周各 3 天记录；最近 14 天至少 12 天明确确认饮食完整。今天未结束，不计入已完成周的复核。饮食修改会使旧的完整确认失效。"
          }
        }
      }
    },
    "health.healthhelpview.when.enabled.reports.send.only.necessary.42d36d": {
      "comment": "HealthHelpView display text",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When enabled, reports send only necessary fact summaries, rule candidates and missing-data flags. They exclude names, contact details, free-text notes, precise location and complete heart-rate series. Each new report rechecks health data readability; failed reads never upload old cached health data to fill gaps."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "启用后的报告仅发送必要的事实汇总、规则候选和缺失标记，不发送姓名、联系方式、自由文本备注、精确位置或完整心率序列。每次新报告重新确认健康数据可读，读取失败时不会用旧健康缓存补齐上传。"
          }
        }
      }
    },
    "health.healthhelpview.you.can.share.only.some.data.30e895": {
      "comment": "HealthHelpView display text",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can share only some data types. No samples, read failures and no connection are handled separately; empty data does not indicate denied access. Imported data is used for local analysis and cached for up to 90 days. The cache and read anchors are excluded from system backups and exported JSON."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可只共享部分类型。没有样本、读取失败和未连接会分别处理，空数据不表示拒绝权限。导入数据用于本机分析，缓存最多保留 90 天；缓存及读取锚点不进入系统备份或导出的 JSON。"
          }
        }
      }
    },
