    "settings.aboutPrivacy": {
      "comment": "settings aboutPrivacy",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Training and nutrition records stay on this device. Apple Health and AI reports are separate choices. Records are not sent when no live AI service is configured. Analysis provides estimates, not medical diagnoses."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "训练和饮食记录保存在本机。Apple 健康与 AI 报告分别选择；未配置真实 AI 服务时不会发送记录。分析是估计，不提供医疗诊断。"
          }
        }
      }
    },
    "settings.aiReports": {
      "comment": "settings aiReports",
      "extractionState": "manual",
      "localizations": {
