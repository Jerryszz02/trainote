    "health.healthonboardingview.ai.reports.explain.local.calculations.and.651995": {
      "comment": "HealthOnboardingView display text",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "AI reports explain local calculations and allowed suggestions. When enabled, necessary workout, food, weight and health trend summaries are processed by DeepSeek through a proxy. Connecting Apple Health does not consent to third-party sharing."
          }
