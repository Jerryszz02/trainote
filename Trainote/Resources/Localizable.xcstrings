    "interaction.help.nutrition": {
      "comment": "interaction.help.nutrition",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nutrition calculations and complete records"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "饮食计算与完整记录"
          }
        }
      }
    },
    "interaction.help.portionHelp": {
      "comment": "interaction.help.portionHelp",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "For servings, enter nutrition per serving and the number of servings. For per-100-g records, enter nutrition per 100 g and the actual grams. Changing the portion scales the current unit nutrition. After correcting totals, later portion changes use the corrected density. Favorites save the current unit nutrition."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按份记录时填写每份营养与份数；按每 100 克记录时填写每 100 克营养与实际克数。修改份量按当前单位营养缩放；修改总量后再改份量，按修正后的密度计算。常用食物保存当前单位营养。"
          }
        }
      }
    },
    "interaction.help.quickStart": {
      "comment": "interaction.help.quickStart",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Quick start and terminology"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "快速开始与术语"
          }
        }
      }
    },
    "interaction.help.recordHelp": {
      "comment": "interaction.help.recordHelp",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "After adding an exercise, enter weight, reps, or duration and tap “Complete set” to record the set. “Finish workout” ends the session. Going back or switching tabs preserves the workout in progress."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "添加动作后填写重量、次数或时长，点“完成本组”记录这一组；“结束训练”结束整场。返回和切换 Tab 会保留进行中训练。"
          }
        }
      }
    },
    "interaction.help.recoveryEstimate": {
      "comment": "interaction.help.recoveryEstimate",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Recovery estimate"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "恢复估计"
          }
        }
      }
    },
    "interaction.help.reuseHelp": {
      "comment": "interaction.help.reuseHelp",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can also use recent entries, favorite foods, fixed meals, or copy a meal. Reuse creates independent records and leaves the original history unchanged. Canceling source selection returns to your original draft."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "直接记录以外，还可使用最近、常用食物、固定餐或复制一餐。复用会生成独立记录，原历史不变；取消来源选择会回到原草稿。"
          }
        }
      }
    },
    "interaction.help.rirHelp": {
      "comment": "interaction.help.rirHelp",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "RIR is the estimated number of reps you could still perform at the end of a set. It is optional; leaving it blank does not mean zero. Working sets contribute to load analysis; warm-up sets do not."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "RIR 是这一组结束时估计还能完成的次数，可以不填；未填不等于 0。工作组用于分析负荷，热身组不计入。"
          }
        }
      }
    },
    "interaction.help.sources": {
      "comment": "interaction.help.sources",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sources and licenses"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "来源与许可"
          }
        }
      }
    },
    "interaction.help.startHelp": {
      "comment": "interaction.help.startHelp",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On Today, tap “Start workout”, then “Start directly”. No routine, body profile, or health permission is required. If a workout is already in progress, tap “Continue workout” to return to it."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "今日点“开始训练”后选“直接开始”，不需要模板、身体资料或健康权限。已有进行中训练时，点“继续训练”回到原记录。"
          }
        }
      }
    },
